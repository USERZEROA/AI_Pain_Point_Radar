# Run python scripts/start.py to generate a private .env with a random password.
# Never commit your real .env, DATABASE_URL or API credentials.
POSTGRES_USER=radar
POSTGRES_DB=radar
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
STREAM_MODE=replay
REPLAY_INTERVAL=1
REPLAY_LOOP=true
SEED_LIMIT=600
LOOKBACK_DAYS=30
POLL_SECONDS=30
KAFKA_TOPIC=ai_user_feedback
STORAGE_GROUP=ai-feedback-storage-v1
ANALYTICS_GROUP=ai-feedback-analysis-v1
PUBLIC_DOMAIN=localhost

# External managed services only (Docker Compose constructs these internally):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
# KAFKA_BOOTSTRAP_SERVERS=HOST:9092
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
